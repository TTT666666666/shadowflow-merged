{
  "name": "shadowflow-merged",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "ShadowFlow merged repo: new frontend (marketing site + CEO workbench) x legacy backend (Node gateway + Python FastAPI)",
  "type": "module",
  "scripts": {
    "dev": "node dev.mjs",
    "dev:web": "npm --prefix frontend run dev",
