node_modules/
dist/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.tmp-*
*.sqlite
*.sqlite-shm
*.sqlite-wal
# .shadowflow 运行时数据不入库，但内置 AI 组织种子（agents/teams）要随仓库走
.shadowflow/*
!.shadowflow/agents/
!.shadowflow/teams/
# Node 网关运行时数据目录（app.sqlite、embedding-config.json 等含密钥文件）
backend/node/.shadowflow/
.env
.env.*
!.env.example
*.log
.DS_Store

# E2E 演示运行时产物（会话 token、测试素材），不入库
.sf-token
.e2e-fixtures/
.workbuddy/memory/

# Python 后端运行时数据（群 JSON、runtime.sqlite、tool schema 缓存）不入库
backend/python/.shadowflow/
backend/python/_data/

# 用户/测试导入的自定义流程模板（运行时目录，seed 模板在 templates/*.yaml）
templates/custom/

# 服务以仓库根为 cwd 启动时写的运行时数据（tool schema 缓存等）
/_data/
